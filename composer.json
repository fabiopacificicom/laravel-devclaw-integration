{
    "name": "pacificdev/laravel-devclaw-integration",
    "description": "DevClaw agent integration for Laravel — exposes a secure API for Olly/OpenClaw to communicate with the platform admin agent",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Pacificdev\\DevClaw\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pacificdev\\DevClaw\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Pacificdev\\DevClaw\\DevClawServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
